<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The ISRG (Let's Encrypt) roots are ADDED because Android 6.0
     does not include them; system roots stay trusted and nothing is disabled. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
